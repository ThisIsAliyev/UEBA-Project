# UEBA AI Server Configuration
# =============================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# REQUIRED: API key for authentication (minimum 16 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVER_API_KEY=your-secret-api-key-here

# Comma-separated list of allowed client IPs
# Leave empty to allow all IPs (not recommended for production)
AI_SERVER_ALLOWED_IPS=192.168.213.136

# Server binding
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8000

# Ollama configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Logging level (DEBUG, INFO, WARNING, ERROR)
AI_SERVER_LOG_LEVEL=INFO
