# UEBA Web Server Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ===========================================
# AI Server Integration
# ===========================================

# AI Server URL (Ubuntu VM with Ollama)
AI_SERVER_URL=http://192.168.213.138:8000

# API key for AI Server authentication
# Must match AI_SERVER_API_KEY on the AI Server
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVER_API_KEY=your-secret-api-key-here

# Request timeout in seconds (Ollama can be slow)
AI_SERVER_TIMEOUT=45

# ===========================================
# n8n Webhook Integration
# ===========================================

# n8n webhook URL for IOC reputation workflow
# Get this from n8n after creating the workflow
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/ioc-reputation

# Request timeout in seconds
N8N_WEBHOOK_TIMEOUT=30

# Rate limit (calls per hour) - protect free tier quota
N8N_RATE_LIMIT=100

# ===========================================
# Optional: Override config file settings
# ===========================================

# Server ports (usually set in server_config.yaml)
# INGEST_PORT=9000
# WEB_PORT=8080

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
