<!--
  Sysmon Maximum Capture Configuration
  Based on sysmonconfig-export.xml but optimized for maximum event capture
  
  This configuration:
  - Removes most exclude filters to capture maximum events
  - Keeps only essential noise reduction (Windows telemetry, etc.)
  - Enables all Sysmon event types
  - Suitable for UEBA systems that need comprehensive log data
  
  REQUIRED: Sysmon version 13 or higher
  https://docs.microsoft.com/en-us/sysinternals/downloads/sysmon
  
  Apply with: sysmon64.exe -c sysmonconfig-max.xml
  Or: Sysmon.exe -c sysmonconfig-max.xml
-->

<Sysmon schemaversion="4.50">
	<!--SYSMON META CONFIG-->
	<HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
	<CheckRevocation/>

	<EventFiltering>

	<!--SYSMON EVENT ID 1 : PROCESS CREATION [ProcessCreate]-->
	<!--MAX CAPTURE: Log all processes, exclude only essential Windows telemetry noise-->
	<RuleGroup name="" groupRelation="or">
		<ProcessCreate onmatch="exclude">
			<!--Essential Windows telemetry/background tasks only-->
			<CommandLine condition="begin with"> "C:\Windows\system32\wermgr.exe" "-queuereporting_svc" </CommandLine>
			<CommandLine condition="begin with">C:\Windows\system32\DllHost.exe /Processid</CommandLine>
			<CommandLine condition="is">C:\Windows\system32\wermgr.exe -upload</CommandLine>
			<CommandLine condition="is">C:\windows\system32\wermgr.exe -queuereporting</CommandLine>
		</ProcessCreate>
	</RuleGroup>

	<!--SYSMON EVENT ID 2 : FILE CREATION TIME CHANGED [FileCreateTime]-->
	<!--MAX CAPTURE: Log all file time changes-->
	<RuleGroup name="" groupRelation="or">
		<FileCreateTime onmatch="include">
			<!--Log everything - no excludes-->
		</FileCreateTime>
	</RuleGroup>

	<!--SYSMON EVENT ID 3 : NETWORK CONNECTION [NetworkConnect]-->
	<!--MAX CAPTURE: Log all network connections-->
	<RuleGroup name="" groupRelation="or">
		<NetworkConnect onmatch="include">
			<!--Log everything - no excludes-->
		</NetworkConnect>
	</RuleGroup>

	<!--SYSMON EVENT ID 5 : PROCESS TERMINATED [ProcessTerminate]-->
	<!--MAX CAPTURE: Log all process terminations-->
	<RuleGroup name="" groupRelation="or">
		<ProcessTerminate onmatch="include">
			<!--Log everything - no excludes-->
		</ProcessTerminate>
	</RuleGroup>

	<!--SYSMON EVENT ID 6 : DRIVER LOADED [DriverLoad]-->
	<!--MAX CAPTURE: Log all driver loads, exclude only Microsoft-signed drivers for noise reduction-->
	<RuleGroup name="" groupRelation="or">
		<DriverLoad onmatch="exclude">
			<Signature condition="contains">microsoft</Signature>
			<Signature condition="contains">windows</Signature>
		</DriverLoad>
	</RuleGroup>

	<!--SYSMON EVENT ID 7 : IMAGE LOADED [ImageLoad]-->
	<!--MAX CAPTURE: Log all image loads-->
	<RuleGroup name="" groupRelation="or">
		<ImageLoad onmatch="include">
			<!--Log everything - no excludes-->
		</ImageLoad>
	</RuleGroup>

	<!--SYSMON EVENT ID 8 : CREATE REMOTE THREAD [CreateRemoteThread]-->
	<!--MAX CAPTURE: Log all remote thread creation-->
	<RuleGroup name="" groupRelation="or">
		<CreateRemoteThread onmatch="include">
			<!--Log everything - no excludes-->
		</CreateRemoteThread>
	</RuleGroup>

	<!--SYSMON EVENT ID 9 : RAW ACCESS READ [RawAccessRead]-->
	<!--MAX CAPTURE: Log all raw disk access-->
	<RuleGroup name="" groupRelation="or">
		<RawAccessRead onmatch="include">
			<!--Log everything - no excludes-->
		</RawAccessRead>
	</RuleGroup>

	<!--SYSMON EVENT ID 10 : PROCESS ACCESS [ProcessAccess]-->
	<!--MAX CAPTURE: Log all process access attempts-->
	<RuleGroup name="" groupRelation="or">
		<ProcessAccess onmatch="include">
			<!--Log everything - no excludes-->
		</ProcessAccess>
	</RuleGroup>

	<!--SYSMON EVENT ID 11 : FILE CREATE [FileCreate]-->
	<!--MAX CAPTURE: Log all file creation events-->
	<RuleGroup name="" groupRelation="or">
		<FileCreate onmatch="include">
			<!--Log everything - no excludes-->
		</FileCreate>
	</RuleGroup>

	<!--SYSMON EVENT ID 12,13,14 : REGISTRY EVENTS [RegistryEvent]-->
	<!--MAX CAPTURE: Log all registry modifications-->
	<RuleGroup name="" groupRelation="or">
		<RegistryEvent onmatch="include">
			<!--Log everything - no excludes-->
		</RegistryEvent>
	</RuleGroup>

	<!--SYSMON EVENT ID 15 : FILE CREATE STREAM HASH [FileCreateStreamHash]-->
	<!--MAX CAPTURE: Log all file stream creation-->
	<RuleGroup name="" groupRelation="or">
		<FileCreateStreamHash onmatch="include">
			<!--Log everything - no excludes-->
		</FileCreateStreamHash>
	</RuleGroup>

	<!--SYSMON EVENT ID 17,18 : PIPE EVENTS [PipeEvent]-->
	<!--MAX CAPTURE: Log all named pipe events-->
	<RuleGroup name="" groupRelation="or">
		<PipeEvent onmatch="include">
			<!--Log everything - no excludes-->
		</PipeEvent>
	</RuleGroup>

	<!--SYSMON EVENT ID 19,20,21 : WMI EVENTS [WmiEvent]-->
	<!--MAX CAPTURE: Log all WMI events-->
	<RuleGroup name="" groupRelation="or">
		<WmiEvent onmatch="include">
			<!--Log everything - no excludes-->
		</WmiEvent>
	</RuleGroup>

	<!--SYSMON EVENT ID 22 : DNS QUERY [DnsQuery]-->
	<!--MAX CAPTURE: Log all DNS queries (can be very noisy)-->
	<RuleGroup name="" groupRelation="or">
		<DnsQuery onmatch="include">
			<!--Log everything - no excludes-->
			<!--NOTE: DNS logging is very noisy. Consider excluding routine system queries if needed-->
		</DnsQuery>
	</RuleGroup>

	<!--SYSMON EVENT ID 23 : FILE DELETE [FileDelete]-->
	<!--MAX CAPTURE: Log all file deletions-->
	<RuleGroup name="" groupRelation="or">
		<FileDelete onmatch="include">
			<!--Log everything - no excludes-->
		</FileDelete>
	</RuleGroup>

	<!--SYSMON EVENT ID 24 : CLIPBOARD CHANGE [ClipboardChange]-->
	<!--MAX CAPTURE: Log all clipboard changes-->
	<RuleGroup name="" groupRelation="or">
		<ClipboardChange onmatch="include">
			<!--Log everything - no excludes-->
		</ClipboardChange>
	</RuleGroup>

	<!--SYSMON EVENT ID 25 : PROCESS TAMPERING [ProcessTampering]-->
	<!--MAX CAPTURE: Log all process tampering attempts-->
	<RuleGroup name="" groupRelation="or">
		<ProcessTampering onmatch="include">
			<!--Log everything - no excludes-->
		</ProcessTampering>
	</RuleGroup>

	</EventFiltering>
</Sysmon>

